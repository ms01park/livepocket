{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "redirects": [
    {
      "source": "/concert-detail.html",
      "has": [{ "type": "query", "key": "id", "value": "(?<id>\\d+)" }],
      "destination": "/performances/:id",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/performances/:id", "destination": "/api/concert-detail/:id" },
    { "source": "/tickets/verify/:token", "destination": "/ticket-verify.html" }
  ],
  "headers": [
    {
      "source": "/assets/app.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/styles.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "server.js": {
      "maxDuration": 10,
      "includeFiles": "{*.html,assets/**,config/**}"
    },
    "api/server.js": {
      "maxDuration": 10,
      "includeFiles": "{*.html,assets/**,config/**}"
    }
  }
}
